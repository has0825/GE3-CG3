# Blender v3.2.0 OBJ File: 'road.blend'
# www.blender.org
# UV tiling: 4x depth (U), 2x width (V) for natural road texture appearance
mtllib road.mtl
o Road_Tile
v -1.000000 -1.000000 -0.000000
v 1.000000 -1.000000 -0.000000
v -1.000000 1.000000 0.000000
v 1.000000 1.000000 0.000000
vt 2.000000 0.000000
vt 0.000000 1.000000
vt 0.000000 0.000000
vt 2.000000 1.000000
vn -0.0000 -0.0000 1.0000
usemtl Mat_Road
s off
f 2/1/1 3/2/1 1/3/1
f 2/1/1 4/4/1 3/2/1
